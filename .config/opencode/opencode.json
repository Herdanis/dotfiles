{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "@browsermcp/mcp@latest"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "/opt/homebrew/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--open-web-dashboard",
        "False"
      ]
    },
    "tmux": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tmux-mcp",
        "--shell-type=fish"
      ]
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "model": "modelnyaw/glm-5.2",
  "permission": {
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cat *": "allow",
      "less *": "allow",
      "more *": "allow",
      "wc *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "which *": "allow",
      "type *": "allow",
      "du *": "allow",
      "df *": "allow",
      "ps *": "allow",
      "env *": "allow",
      "printenv *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "id *": "allow",
      "date *": "allow",
      "uname *": "allow",
      "hostname *": "allow",
      "uptime": "allow",
      "who": "allow",
      "w": "allow",
      "last *": "allow",
      "rg *": "allow",
      "rg": "allow",
      "ag *": "allow",
      "jq *": "allow",
      "bat *": "allow",
      "bat": "allow",
      "glow *": "allow",
      "tree *": "allow",
      "tldr *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git rev-parse *": "allow",
      "git config --get *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git stash list": "allow",
      "git tag": "allow",
      "git tag *": "allow"
    },
    "edit": "ask",
    "webfetch": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "websearch": "allow",
    "external_directory": "allow"
  },
  "plugin": [
    "opencode-supermemory",
    "opencode-goal-plugin",
    "opencode-vibeguard",
    "opencode-websearch-cited",
    "opencode-pty",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "lmstudio": {
      "name": "LM Studio (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8998/v1",
        "apiKey": "123123"
      },
      "models": {
        "gpt-oss-20b-MXFP4-Q8": {
          "name": "gpt-oss-20b-MXFP4-Q8",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 2000000
          }
        }
      }
    }
  },
  "small_model": "modelnyaw/kimi-k2.7-code"
}
