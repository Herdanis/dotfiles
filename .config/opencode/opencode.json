{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "@browsermcp/mcp@latest"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "/opt/homebrew/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--open-web-dashboard",
        "False"
      ]
    },
    "tmux": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tmux-mcp",
        "--shell-type=fish"
      ]
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "model": "modelnyaw/glm-5.2",
  "permission": {
    "bash": {
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cat *": "allow",
      "less *": "allow",
      "more *": "allow",
      "wc *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "which *": "allow",
      "type *": "allow",
      "du *": "allow",
      "df *": "allow",
      "ps *": "allow",
      "env *": "allow",
      "printenv *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "id *": "allow",
      "date *": "allow",
      "uname *": "allow",
      "hostname *": "allow",
      "uptime": "allow",
      "who": "allow",
      "w": "allow",
      "last *": "allow",
      "rg *": "allow",
      "rg": "allow",
      "ag *": "allow",
      "jq *": "allow",
      "bat *": "allow",
      "bat": "allow",
      "glow *": "allow",
      "tree *": "allow",
      "tldr *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git rev-parse *": "allow",
      "git config --get *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git stash list": "allow",
      "git tag": "allow",
      "git tag *": "allow",
      "*": "ask"
    },
    "edit": "ask",
    "webfetch": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "websearch": "allow",
    "external_directory": "allow"
  },
  "plugin": [
    "opencode-supermemory",
    "opencode-goal-plugin",
    "opencode-vibeguard",
    "opencode-websearch-cited",
    "opencode-pty",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "lmstudio": {
      "name": "LM Studio (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8998/v1",
        "apiKey": "123123"
      },
      "models": {
        "gpt-oss-20b-MXFP4-Q8": {
          "name": "gpt-oss-20b-MXFP4-Q8",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 2000000
          }
        }
      }
    },
    "modelnyaw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Modelnyaw",
      "models": {
        "auto-debug": {
          "name": "Auto Debug",
          "tool_call": true
        },
        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5",
          "tool_call": true
        },
        "claude-sonnet-4.5-thinking": {
          "name": "Claude Sonnet 4.5 Thinking",
          "tool_call": true
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "tool_call": true
        },
        "deepseek-v4-mod": {
          "name": "DeepSeek V4 Mod",
          "tool_call": true
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "tool_call": true
        },
        "glm-5.2": {
          "name": "GLM 5.2",
          "tool_call": true
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "tool_call": true
        },
        "gpt-5.6": {
          "name": "GPT 5.6",
          "tool_call": true
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "tool_call": true
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "tool_call": true
        },
        "hy3": {
          "name": "HY3",
          "tool_call": true
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "tool_call": true
        },
        "kimi-k2.7-code-highspeed": {
          "name": "Kimi K2.7 Code Highspeed",
          "tool_call": true
        },
        "kimi-k3": {
          "name": "Kimi K3",
          "tool_call": true
        },
        "mimo-v2.5-pro": {
          "name": "Mimo V2.5 Pro",
          "tool_call": true
        }
      }
    }
  },
  "small_model": "modelnyaw/kimi-k2.7-code",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true },
    "scout": { "disable": true }
  }
}
